rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all for all unmapped documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security validation helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and private memories isolation: /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Strict per-user isolation: /users/{userId}/memories/{memoryId}
      match /memories/{memoryId} {
        // Only the owner can read their own memories
        allow get, list: if isOwner(userId) && isValidId(memoryId);

        // Only the owner can create memories under their own document tree
        allow create: if isOwner(userId)
          && isValidId(memoryId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 300;

        // Updates must preserve ownership
        allow update: if isOwner(userId)
          && isValidId(memoryId)
          && request.resource.data.userId == userId
          && resource.data.userId == userId;

        // Only the owner can delete their own memories
        allow delete: if isOwner(userId) && isValidId(memoryId);
      }
    }
  }
}
